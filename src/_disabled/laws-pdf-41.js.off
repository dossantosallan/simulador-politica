LAWS.forEach(l=>{LAW[l.id]=l});
// consolidação em dois blocos
function consolidate(S){const mv=(from,to)=>['cd','sn'].forEach(k=>{const n=Math.round(S.seats[from][k]*.7);S.seats[from][k]-=n;S.seats[to][k]+=n});
 BL.forEach(b=>{if(b.id==='PT'||b.id==='PLB')return;mv(b.id,b.pos<.25?'PT':'PLB')});logE(S,'law','Sistema político: dois blocos')}
const constEv=S=>{const win=RE()<.5;return win?{id:'t-const',tag:'Sinal positivo: constituinte',t:'A Constituinte exclusiva avança',d:'A assembleia foi eleita com boa participação e propõe ajustes bem aceitos pela população.',o:[{t:'Acolher as propostas',h:'Ganho popular e de relação com governadores.',e:{mood:{all:6},rel:{all:8},inst:-5}}]}:{id:'t-const',tag:'Crise política',t:'A Constituinte exclusiva gera instabilidade',d:'A assembleia entra em choque com o Congresso e o Judiciário. Mercados reagem mal.',o:[{t:'Tentar contornar a crise',h:'A aprovação cai e a confiança dos investidores também.',e:{mood:{all:-5},rat:-3,gn:-.003,inst:15}}]}};
EV.push(
{id:'btcalta',cond:S=>S.fl&&S.fl.btc,t:'Bitcoin dispara no mercado mundial',d:'As reservas e o setor de tecnologia do país se valorizam com a alta da criptomoeda.',o:[{t:'Realizar parte do lucro',h:'Receita de R$ 15 bi e nota de crédito melhor.',e:{cost:-15,rat:2}},{t:'Manter a posição',h:'Investimento em tecnologia sobe, com risco.',e:{inv:.5,gn:.002}},{t:'Apostar mais',h:'Ganho maior agora e mais exposição à volatilidade.',e:{inv:.8,gn:.003,rat:-1,inst:4}}]},
{id:'btcbaixa',cond:S=>S.fl&&S.fl.btc,t:'Bitcoin despenca',d:'A queda da criptomoeda reduz reservas e abala a confiança de investidores em tecnologia.',o:[{t:'Socorrer o setor',h:'R$ 12 bi. Limita o dano ao crescimento.',e:{cost:12,gn:-.001,rat:-1}},{t:'Deixar o mercado ajustar',h:'A nota de crédito e o PIB sentem o golpe.',e:{rat:-4,gn:-.003,inv:-.6}},{t:'Reforçar as reservas em ativos tradicionais',h:'R$ 6 bi. Estabiliza a nota.',e:{cost:6,rat:1}}]});
EV.forEach(e=>{EVm[e.id]=e});
